    "enabledDeployMode": "server",
    "issuePath": "/api/voice/asr-assets/{assetId}/sign",
    "localBehavior": "skip-signing-and-real-asr",
    "serverAcceptanceTasks": [
      "TEST-111",
      "TEST-112"
    ]
  },
  "credentialStorage": "server-only environment; no credentials in this file"
}
