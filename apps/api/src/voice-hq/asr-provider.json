{
  "schemaVersion": 1,
  "provider": "aliyun-filetrans",
  "model": "qwen-audio-3.0-asr-flash-filetrans",
  "baseUrl": "https://ws-imp5vxamz4ohf5kp.cn-beijing.maas.aliyuncs.com/api/v1",
  "apiKeyEnv": "VOICE_HQ_ASR_API_KEY",
  "submit": {
    "method": "POST",
    "path": "/services/audio/asr/transcription",
    "headers": {
      "Content-Type": "application/json",
      "X-DashScope-Async": "enable"
    },
    "parameters": {
      "channel_id": [
        0
      ]
    }
  },
