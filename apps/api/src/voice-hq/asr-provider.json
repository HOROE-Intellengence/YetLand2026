    "method": "GET",
    "path": "/tasks/{task_id}"
  },
  "input": {
    "type": "file_urls",
    "maxFilesPerRequest": 1,
    "requiresProviderReachableUrl": true
  },
  "integrationStatus": "integrated-local-verified-server-acceptance-pending",
