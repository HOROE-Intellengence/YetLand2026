# 统一行尾：仓库内一律 LF，消除 core.autocrlf=true 下的 CRLF/LF 提交噪音。
# 仅影响后续提交的归一化；不会主动重写历史文件（需要时另跑 git add --renormalize .）。
* text=auto eol=lf
# 明确文本类型，避免含多字节/控制字符的源文件被误判为二进制
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
# Windows 脚本按惯例保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
# 二进制资源：不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
ai-virtual-phone-main.zip filter=lfs diff=lfs merge=lfs -text
