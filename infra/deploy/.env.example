# ============================================================================
#  夜阑 · 服务器部署环境变量
#  ----------------------------------------------------------------------------
#  用法：cp .env.example .env  之后改下面的值
#  这个文件 docker-compose 会读；不会进 git。
# ============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────
# 你的域名（Caddy 用它申请 HTTPS 证书）
DOMAIN=api.example.com

# 可选：启用 docker-compose.phone.yml 时填写手机独立域名，并将 DNS 指向同一服务器。
# 不启用覆盖文件时原部署保持不变。
PHONE_DOMAIN=phone.example.com

# 后台管理 token（不能保留默认 admin-dev-token，server 模式启动会拒绝）
ADMIN_TOKEN=请改成强随机字符串32位以上

# CORS 白名单（前端域名，多个用逗号分隔；'*' 也可但生产不推荐）
CORS_ORIGINS=https://app.example.com

# ── LLM API key（任填一个） ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 模型名（可选；不填用默认）
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat
NVIDIA_MODEL=z-ai/glm-5.1

# ADR-0009: 边缘 Worker ↔ Node 后端互验内部 token
# Caddy 直连部署保持 false；只有走 Cloudflare Worker edge 转发到 Node 时才改 true。
# 改 true 时必须设置 INTERNAL_TOKEN，且与 Cloudflare Workers Secret INTERNAL_TOKEN 完全相同。
INTERNAL_TOKEN=
INTERNAL_TOKEN_REQUIRED=false

# ── 策略（可选） ────────────────────────────────────────────────────────
# 全局合规边界：1=纯净 2=克制 3=暧昧 4=显性 5=直白
NARRATIVE_BOUNDARY_GLOBAL=3

# token 累计硬闸开关：off → 关闭单会话累计 token 上限（长会话不再回退默认脚本台词）。
# 缺省/任何非 off 值 = 开启（默认上限：单会话 20 万 / 全日 200 万 token）。
# 长会话降级最终交由上下文压缩处理；关闭为过渡措施。
TOKEN_GUARD_ENABLED=off

# 是否对外暴露 /admin 控制台（生产建议改 false 走独立 admin 前端）
ENABLE_ADMIN_CONSOLE=true

# ── 控制台秘密入口（降低被扫描发现的概率） ──────────────────────────────────
# 控制台不挂在众所周知的 /admin，而是挂在下面这个路径上（由 Caddy 改写转发）。
# · 改成你自己的随机串，越长越没规律越好（例：/x7Kq9-ops）。别用真实业务词。
# · 直接访问 /admin 会被装死成 landing 页，和「路径不存在」无法区分。
# · 这是「路径式秘密」：会出现在浏览器历史和 Caddy 日志里，只降噪、不替代 ADMIN_TOKEN。
# · 轮换：改这里 → docker compose restart caddy，无需改代码或重新构建。
# 注意：本文件不进 git，所以真实路径不会泄露到仓库。
ADMIN_PATH=/__console_change_me__
# Voice outbound relay (wss://your-worker-domain/google-live).
# Google key stays in Worker Secrets. Never set ws:// in server mode.
VOICE_RELAY_URL=
VOICE_RELAY_TOKEN=

# 阿里下载输入录音的短效签名链接（仅 server 启用）
# 与实际可从公网访问的 HTTPS 源站一致，不含 /api 等路径。
VOICE_ASR_PUBLIC_ORIGIN=https://api.example.com
# 独立强随机密钥，至少 32 字符；可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成。
VOICE_ASR_SIGNING_KEY=
VOICE_ASR_SIGNING_TTL_SECONDS=900
# 服务器构建前后均须执行 docs/TODOlist.md 的 TEST-111 / TEST-112。

# Reserved SMS configuration. The current application flow remains disabled.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=鸿绒云
ALIYUN_SMS_TEMPLATE_CODE=SMS_338905646

# 高质量语音：密钥仅留后端。local 跳过签名/真实 ASR，开启测试文字入口。
VOICE_HQ_FISH_API_KEY=
VOICE_HQ_FISH_BASE_URL=https://api.fish.audio
# 模型固定为 s2.1-pro-free；音色在可视化后台 /admin#voice-library 维护。
VOICE_HQ_ASR_API_KEY=
VOICE_HQ_ASR_BASE_URL=https://ws-imp5vxamz4ohf5kp.cn-beijing.maas.aliyuncs.com/api/v1
VOICE_HQ_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
# 不做概要压缩；超过此字符预算提示开启新会话。
VOICE_HQ_CONTEXT_MAX_CHARS=48000

# 小手机托管生图：仅注入 API 容器，不进入前端镜像。
# 模型由后端固定为 gpt-image-2.5-flare。
IMAGE_API_BASE_URL=https://api.ai-media.vip/v1
IMAGE_API_KEY=
# Bird 邮箱验证码（仅后端）：将 bk_xxxxxxxxx 替换为真实 API key。
BIRD_API_KEY=
