# 复制为 .env 并填值。绝不要提交真实 secret。
# 本地最小可用：只填 ANTHROPIC_API_KEY 即可（或任一其他 LLM key）。

# ─── 部署模式（一键切换的核心开关） ────────────────────────────────────────────
# local   = 本机开发：bind 127.0.0.1，CORS 全开，admin 默认 token 可用
# server  = 服务器生产：bind 0.0.0.0，CORS 白名单，强制非默认 ADMIN_TOKEN
# 通常你不用直接改这个 — pnpm start:local / pnpm start:server 会自动设
DEPLOY_MODE=local

# 仅 server 模式生效：监听地址、端口
MOCK_HOST=127.0.0.1
MOCK_PORT=8787

# 仅 server 模式生效：CORS 白名单（多个用逗号分隔；'*' 也可但生产不推荐）
CORS_ORIGINS=

# 仅 server 模式生效：是否信任 X-Forwarded-* 头（站在 caddy/nginx 后必开）
TRUST_PROXY=true

# 仅 server 模式生效：是否暴露 /admin 静态控制台（生产建议 false 走独立 admin 前端）
ENABLE_ADMIN_CONSOLE=true

# 仅 server 模式生效：是否允许默认 admin-dev-token（生产建议 false）
ALLOW_DEFAULT_ADMIN_TOKEN=false

# ─── LLM API Keys（任填一个即可启用真实流式对话；都为空时走脚本化 mock 流） ─────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 备用：NVIDIA NIM unlim-worker（"侧袋 AI"，本地后台不启用）
NVIDIA_API_KEY=
UNLIM_WORKER_URL=https://unlim.yelan.workers.dev

# ─── 策略 ─────────────────────────────────────────────────────────────────────
# 全局合规上限：1=纯净 2=克制 3=暧昧 4=显性 5=直白
NARRATIVE_BOUNDARY_GLOBAL=3

# 后台运营 token（默认 admin-dev-token，server 模式必须改）
ADMIN_TOKEN=admin-dev-token

# ADR-0009: 边缘 Worker ↔ Node 后端互验内部 token
# 生产环境必须设，且与 Cloudflare Workers Secret INTERNAL_TOKEN 完全相同
INTERNAL_TOKEN=
INTERNAL_TOKEN_REQUIRED=true

# ─── apps/server (Cloudflare Workers，本地部署不需要) ──────────────────────────
DATABASE_URL=postgres://user:pass@host/db
REDIS_URL=

# 支付（按主体启用；mock-server 的 /api/pay 回调对未签名 body 直接接受用于联调）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
STRIPE_SECRET_KEY=

# 监控
SENTRY_DSN_SERVER=

# ─── apps/web (Vite) ─────────────────────────────────────────────────────────
# 默认指向本机 mock-server；移动端发布时改成你的服务器域名
VITE_API_BASE=http://localhost:8787
VITE_USE_MOCK=true
VITE_SENTRY_DSN_WEB=

# ─── apps/api 杂项 ───────────────────────────────────────────────────
MOCK_LATENCY_MS=120
VERBOSE_STARTUP=true
# Voice: local API uses a deployed Worker, or localhost emulator with working Google connectivity.
VOICE_RELAY_URL=
VOICE_RELAY_TOKEN=
# Local-only HTTP/WebSocket proxy for voice providers; ignored outside DEPLOY_MODE=local.
# Example: http://127.0.0.1:7897. Leave empty for direct connections.
VOICE_LOCAL_PROXY_URL=
# Optional. Default: apps/api/.local/voice; FFmpeg defaults to PATH.
VOICE_DATA_DIR=
VOICE_FFMPEG_PATH=

# ASR 录音签名下载：仅 DEPLOY_MODE=server 签发；local 明确 skipped，不调用 ASR。
# 固定公网 HTTPS 源站，不含路径。签名密钥独立于用户 token / ASR API key。
VOICE_ASR_PUBLIC_ORIGIN=
VOICE_ASR_SIGNING_KEY=
# 60–3600 秒；默认 15 分钟，需覆盖阿里下载/排队时间。
VOICE_ASR_SIGNING_TTL_SECONDS=900

# Public API gateway. Default storage: apps/api/.local/gateway/api.sqlite.
# Runtime model selection, limits and advanced prelude are managed in the admin UI.
API_GATEWAY_DATA_DIR=
# SMS placeholder only; no sends or verification until real integration is enabled.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=鸿绒云
ALIYUN_SMS_TEMPLATE_CODE=SMS_338905646

# 高质量语音：密钥仅留后端。local 跳过签名/真实 ASR，开启测试文字入口。
VOICE_HQ_FISH_API_KEY=
VOICE_HQ_FISH_BASE_URL=https://api.fish.audio
# 模型固定为 s2.1-pro-free；音色在可视化后台 /admin#voice-library 维护。
VOICE_HQ_ASR_API_KEY=
VOICE_HQ_ASR_BASE_URL=https://ws-imp5vxamz4ohf5kp.cn-beijing.maas.aliyuncs.com/api/v1
VOICE_HQ_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
# 不做概要压缩；超过此字符预算提示开启新会话。
VOICE_HQ_CONTEXT_MAX_CHARS=48000
